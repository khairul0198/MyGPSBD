<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1D63ED"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvGreetingDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Good evening · Tue, Nov 24"
                android:textColor="#DCE8FF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvUserPhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="01601011171"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnRefresh"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:background="#3B7BF5"
                android:contentDescription="Refresh"
                android:src="@android:drawable/ic_popup_sync" />

            <TextView
                android:id="@+id/tvFleetCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="1"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOnlineCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#7CFFB2"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvOfflineCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvLiveStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Live · No vehicles are online right now"
                android:textColor="#E8F0FF"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TODAY · Distance driven"
                android:textColor="#6B7280"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDistanceDriven"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="0 km"
                android:textColor="#111827"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDistanceSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Across 1 vehicle · open reports"
                android:textColor="#6B7280"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fleet Status"
                android:textColor="#111827"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvViewAllFleet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="View All >"
                android:textColor="#1D63ED"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvRunningCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Running: 0"
                android:textColor="#374151" />

            <TextView
                android:id="@+id/tvIdleCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Idle: 0"
                android:textColor="#374151" />

            <TextView
                android:id="@+id/tvStoppedCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Stopped: 0"
                android:textColor="#374151" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vehicle Care Pulse"
                android:textColor="#111827"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCareBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="At risk"
                android:textColor="#DC2626"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCareSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Healthy: 0 | Need Care: 1"
                android:textColor="#111827" />

            <TextView
                android:id="@+id/tvGpsQuality"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Good GPS: 0% · Fair GPS: 0% · Weak GPS: 0%"
                android:textColor="#6B7280"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shortcuts"
                android:textColor="#111827"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnShortcutMap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Map" />

            <Button
                android:id="@+id/btnShortcutVehicles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Vehicles" />

            <Button
                android:id="@+id/btnShortcutAlerts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Alerts" />

            <Button
                android:id="@+id/btnShortcutReports"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Reports" />

            <Button
                android:id="@+id/btnShortcutGeofence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Geofence" />

            <Button
                android:id="@+id/btnShortcutPoi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="POI" />

            <Button
                android:id="@+id/btnShortcutPlayback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Playback" />

            <Button
                android:id="@+id/btnShortcutSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Settings" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
